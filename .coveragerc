[run]
source = app
omit =
    app/__init__.py
    app/main.py
    app/models.py
    app/bot.py
    app/bot/__init__.py
    # Exclude in-memory debug/monitoring UI from coverage metrics
    app/debug/*
    app/debug/**
    # Exclude internal logging helpers from coverage
    app/logging_flow.py

[report]
show_missing = True
